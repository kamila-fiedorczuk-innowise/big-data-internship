# Copy this file to .env and fill in the empty values.
# Generate passwords and keys with:
# python -c "import secrets, base64, os; print(secrets.token_urlsafe(24)); print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# (the second printed value is a valid AIRFLOW_FERNET_KEY)

AIRFLOW_UID=50000

# Airflow metadata database (PostgreSQL)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=
POSTGRES_DB=airflow

# Airflow web UI admin account
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=

# Airflow internal security keys
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=

# MongoDB root account
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=

# Data paths inside the Airflow containers
DATA_DIR=/opt/airflow/data
PROCESSED_DIR=/opt/airflow/data/processed
INPUT_FILENAME=tiktok_google_play_reviews.csv
